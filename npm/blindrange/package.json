{
  "name": "blindrange",
  "version": "0.2.0",
  "description": "Range queries over storage that cannot read your data. SQL-shaped statements over the blindrange network; runs the reference client, so there is nothing to drift.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alviso/blindrange.git"
  },
  "homepage": "https://blindrange.dev/build-node",
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./web": {
      "import": "./web.mjs"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@alviso/blindrange-python-darwin-arm64": "0.1.1",
    "@alviso/blindrange-python-darwin-x64": "0.1.1",
    "@alviso/blindrange-python-linux-x64": "0.1.1",
    "@alviso/blindrange-python-linux-arm64": "0.1.1",
    "@alviso/blindrange-python-win32-x64": "0.1.1"
  },
  "keywords": [
    "encrypted",
    "database",
    "range-query",
    "privacy",
    "sql"
  ]
}
